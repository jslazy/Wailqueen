# Required: Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Basic
BOT_PREFIX=!
BOT_NAME=WailQueen
AUTO_SYNC=1
DB_PATH=data/bot.db
SUPPORT_URL=

# Rate limit (5 commands per 10 seconds per user)
RATE_LIMIT_COMMANDS=5
RATE_LIMIT_PERIOD=10

# Channel IDs used in the welcome message (0 = none)
PROTOCOL_CHANNEL_ID=0
INFO_BOARD_CHANNEL_ID=0

# Webhook backup (leave the URL empty to turn it off)
BACKUP_WEBHOOK_URL=
BACKUP_WEBHOOK_MODE=send
BACKUP_WEBHOOK_INTERVAL=60

# Anti-nuke (optional)
# AN_WIPE_PUNISH_AT=50
